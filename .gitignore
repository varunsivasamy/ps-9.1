# ---- Generated data ----
# Pre-write snapshots of the transaction CSV. Each is a full ~7 MB copy and
# they are regenerated on every mutation, so they are never committed.
# data/customer_shopping_data.csv itself IS tracked, as the seed state.
data/snapshots/
data/*.csv.tmp

