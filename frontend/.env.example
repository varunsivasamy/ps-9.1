# Copy to .env.local for local dev (Vite loads .env.local automatically).
# Base URL of the PS-9.1 FastAPI backend (autonomy_engine.main:app).
# Local dev default:
VITE_API_BASE_URL=http://127.0.0.1:8000

# When deployed to Vercel, set this in the project's Environment Variables
# to the deployed API Gateway / Lambda URL, e.g.:
# VITE_API_BASE_URL=https://xxxxx.execute-api.us-east-1.amazonaws.com
