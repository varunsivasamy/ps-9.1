# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Anthropic API key used by the agent action layer (Phase 2).
ANTHROPIC_API_KEY=sk-ant-...

# AWS region for DynamoDB / Lambda / SAM deploys.
AWS_REGION=us-east-1

# Prefix for DynamoDB table names. The audit table is
# "<prefix>-audit-log". In AWS this is set from the SAM stack name.
DYNAMODB_TABLE_PREFIX=ps-9-1-autonomy-engine

# Local dev only: point boto3 at a local DynamoDB instead of real AWS.
# Leave unset/empty in AWS. Example: http://localhost:8000
DYNAMODB_ENDPOINT_URL=
