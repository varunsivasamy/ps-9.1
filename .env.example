# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Groq API key used by the agent action layer. Free tier at console.groq.com.
GROQ_API_KEY=gsk_...

# Model the agent runs on. Any Groq-hosted model with tool-calling support
# works; change it here rather than in code if the default is retired or
# rate-limited.
GROQ_MODEL=llama-3.3-70b-versatile

# AWS region for DynamoDB / Lambda / SAM deploys.
AWS_REGION=us-east-1

# Prefix for DynamoDB table names. The audit table is
# "<prefix>-audit-log". In AWS this is set from the SAM stack name.
DYNAMODB_TABLE_PREFIX=ps-9-1-autonomy-engine

# Local dev only: point boto3 at a local DynamoDB instead of real AWS.
# Leave unset/empty in AWS. Example: http://localhost:8000
DYNAMODB_ENDPOINT_URL=

# Transaction CSV the agent actually reads and writes. Defaults to
# data/customer_shopping_data.csv in the repo (~99k rows). Point this at a
# writable copy if the deployment bundle is read-only.
CUSTOMER_DATA_PATH=

# Where pre-write snapshots are kept, so a mutation can be rolled back.
# Defaults to a "snapshots" directory beside CUSTOMER_DATA_PATH.
CUSTOMER_SNAPSHOT_DIR=

# Comma-separated origins allowed to call this API from a browser (CORS).
# Defaults to the Vite dev server if unset. Add your Vercel domain(s) here
# once the front end is deployed, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
